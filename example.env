#
# web Service Configurations
#
WEB_ADDR=":4000"
WEB_DEV_MODE="true"
# Change 'mysql' to 'localhost' if you are running locally. And also make sure
# to change username, password, database name, accordingly.
WEB_DATABASE_URL="root:very-hard-password@tcp(localhost:3306)/mydb?parseTime=true"
WEB_COOKIE_SECURE="false"

#
# mysql Service Configurations
#
MYSQL_ROOT_PASSWORD="very-hard-password"
MYSQL_DATABASE="mydb"