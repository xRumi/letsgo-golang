{{define "base"}}
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{template "title" .}} - Snippetbox</title>
        <link rel="stylesheet" href="/static/css/main.css">
        <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Ubuntu+Mono:400,700'>
        {{block "extendhead" .}}{{end}}
    </head>
    <body>
        {{template "nav" .}}
        <main>
            {{with .Flash}}
                <div>{{.}}</div>
            {{end}}
            {{template "main" .}}
        </main>
        <footer>Powered by <a href="https://golang.org">Go</a> in {{.TimeNow.Year}}</footer>
    </body>
</html>
{{end}}