{{define "title"}}Snippet #{{.Snippet.ID}}{{end}}
{{define "extendhead"}}
    <link rel="stylesheet" href="/static/css/view.css">
{{end}}

{{define "main"}}
    {{with .Snippet}}
        <div class="snippet">
            <div class="metadata">
                <strong>{{.Title}}</strong>
                <strong>{{.ID}}</strong>
            </div>
            <pre><code>{{.Content}}</code></pre>
            <div class="metadata">
                <time>Created: {{.Created}}</time>
                <time>Expires: {{.Expires}}</time>
            </div>
        </div>
    {{end}}
{{end}}